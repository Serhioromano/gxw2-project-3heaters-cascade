(* ==========================================================================
FB_Circulation - выбор работающих циркуляционных насосов малого контура.
Число насосов зависит от количества включённых ступеней котлов,
ведущий насос меняется раз в 24 часа для выравнивания моточасов.
Ручной пуск насоса имеет приоритет.
========================================================================== *)
CASE  ActiveStages  OF
	0..2 :
		NambPump := 1;
	3..4 :
		NambPump := 2;
	5..6 :
		NambPump := 3;			
END_CASE;

ChangeN := bool_to_int( ActivePupmp1 ) + bool_to_int( ActivePupmp2 ) + bool_to_int( ActivePupmp3 ) + bool_to_int( Start )
		+ bool_to_int( ManualPupmp1 ) + bool_to_int(ManualPupmp2 ) + bool_to_int( ManualPupmp3 ) + NambPump;
		
IF ChangeN <> ChangeN2 THEN
	Restart := TRUE;
	ChangeN2 := ChangeN;
END_IF;			 


Pumps[0].Evailable := ActivePupmp1;
Pumps[1].Evailable := ActivePupmp2;
Pumps[2].Evailable := ActivePupmp3;


(* Ведущий насос меняется раз в 24 часа. PT задаётся в TIME (мс),
поэтому считаем в DINT и только результат переводим в TIME *)
NewTime(IN := (Start AND NOT NewTime.Q), PT := DINT_TO_TIME(INT_TO_DINT(24) * 3600 * 1000));


IF NewTime.Q THEN
	Order := Order + 1;
	IF Order > 2 THEN
		Order := 0;
	END_IF;
	Restart	:= TRUE;	
END_IF;

IF Restart THEN 	
	
	FOR NPump := 0 TO 2 DO
			Pumps[NPump].Start := FALSE;			
	END_FOR;
	
	Pumps[0].Start := ManualPupmp1 AND Pumps[0].Evailable;
	Pumps[1].Start := ManualPupmp2 AND Pumps[1].Evailable;
	Pumps[2].Start := ManualPupmp3 AND Pumps[2].Evailable;
	
	FOR NPump := 0 TO 2 DO	
		IF Pumps[NPump].Start THEN
			NambPump := NambPump - 1;
		END_IF;			
	END_FOR;
	
	(* NambPump - сколько насосов ещё нужно запустить после ручных.
	Раньше здесь стояло NPump, а после цикла FOR эта переменная всегда 3 *)
	IF NambPump > 0 THEN
		FOR NPump := Order  TO 2 DO
			IF (Pumps[NPump].Evailable = TRUE) AND NOT (Pumps[NPump].Start = TRUE) AND NambPump > 0 THEN
				Pumps[NPump].Start := TRUE;
				NambPump := NambPump - 1;
			END_IF;	
			
			IF NambPump < 1 THEN
				EXIT;
			END_IF;			
		END_FOR;
		
		FOR NPump := 0 TO 2 DO
			IF (Pumps[NPump].Evailable = TRUE) AND NOT (Pumps[NPump].Start = TRUE) AND NambPump > 0 THEN
				Pumps[NPump].Start := TRUE;
				NambPump := NambPump - 1;
			END_IF;	
			IF NambPump < 1 THEN
				EXIT;
			END_IF;			
		END_FOR;
	END_IF;	
	Restart := FALSE;
END_IF;

IF NOT Start THEN
	Pumps[0].Start := FALSE;
	Pumps[1].Start := FALSE;
	Pumps[2].Start := FALSE;
END_IF;

StartPump1 := Pumps[0].Start AND Pumps[0].Evailable;
StartPump2 := Pumps[1].Start AND Pumps[1].Evailable;
StartPump3 := Pumps[2].Start AND Pumps[2].Evailable;
