(* ==========================================================================
   PRG_PROCESS - обработка входов, аварий, состояний и моточасов.
   Карта аналоговых входов (модули Coolmay, R-регистры):
     R23700..R23702 - температура котлов 1..3 (Pt100, 0.1 C)
     R23703 - обратка отопления, R23705 - подача отопления
     R23704 - подача на котлы (коллектор), R23706/R23707 - теплообменник
     R23708 - температура наружного воздуха, R23709 - температура газа
     R23712..R23714 - давление котлов 1..3, R23715 - подача во внешнюю систему
     R23716 - обратка внешняя, R23717/R23718 - теплообменник
     R23719 - давление коллектора первичного контура (подпитка)
     D8032 - давление газа (встроенный вход модуля)
   Cor_* - поправки датчиков, задаются с панели.
   ========================================================================== *)
EI(TRUE);

AI_T_Heater1 := R23700 + Cor_T_Heater1;
AI_T_Heater2 := R23701 + Cor_T_Heater2;
AI_T_Heater3 := R23702 + Cor_T_Heater3;
AI_T_Colector := R23704 + Cor_T_Colector;
AI_T_SOFrom := R23703 + Cor_T_SOFrom;
AI_T_SOTo := R23705 + Cor_T_SOTo;
AI_T_GVSTo := R23706 + Cor_T_GVSTo;
AI_T_GVSFrom := R23707 + Cor_T_GVSFrom;
AI_T_Gaz := R23709 + Cor_T_Gaz;
AI_T_Weather := R23708 + Cor_T_Weather;

(* Замерил руками на 20ма значение 29900-30200
поэтому назначаю высшее значение средние 30000 *)
AI_P1 := F_SCALE(R23712, 0, 30000, 0, Max_P1, FALSE);
AI_P2 := F_SCALE(R23713, 0, 30000, 0, Max_P2, FALSE);
AI_P3 := F_SCALE(R23714, 0, 30000, 0, Max_P3, FALSE);
AI_P_SOTo := F_SCALE(R23715, 0, 30000, 0, Max_P_SOTo, FALSE);
AI_P_SOFrom := F_SCALE(R23716, 0, 30000, 0, Max_P_SOFrom, FALSE);
AI_P_GVSTo := F_SCALE(R23717, 0, 30000, 0, Max_P_GVSTo, FALSE);
AI_P_GVSFrom := F_SCALE(R23718, 0, 30000, 0, Max_P_GVSFrom, FALSE);
AI_P_Set := F_SCALE(R23719, 0, 30000, 0, Max_P_Set, FALSE);
AI_P_GAZ := F_SCALE(D8032, 0, 4030, 0, Max_P_GAZ, FALSE);

FAI_T_Heater1 := INT_TO_REAL(AI_T_Heater1) / 10.0;
FAI_T_Heater2 := INT_TO_REAL(AI_T_Heater2) / 10.0;
FAI_T_Heater3 := INT_TO_REAL(AI_T_Heater3) / 10.0;
FAI_T_Colector := INT_TO_REAL(AI_T_Colector) / 10.0;
FAI_T_SOFrom := INT_TO_REAL(AI_T_SOFrom) / 10.0;
FAI_T_SOTo := INT_TO_REAL(AI_T_SOTo) / 10.0;
FAI_T_GVSTo := INT_TO_REAL(AI_T_GVSTo) / 10.0;
FAI_T_GVSFrom := INT_TO_REAL(AI_T_GVSFrom) / 10.0;
FAI_T_Gaz := INT_TO_REAL(AI_T_Gaz) / 10.0;
FAI_T_Weather := INT_TO_REAL(AI_T_Weather) / 10.0;

FAI_P1 := INT_TO_REAL(AI_P1) / 10.0;
FAI_P2 := INT_TO_REAL(AI_P2) / 10.0;
FAI_P3 := INT_TO_REAL(AI_P3) / 10.0;
FAI_P_SOTo := INT_TO_REAL(AI_P_SOTo) / 10.0;
FAI_P_SOFrom := INT_TO_REAL(AI_P_SOFrom) / 10.0;
FAI_P_GVSTo := INT_TO_REAL(AI_P_GVSTo) / 10.0;
FAI_P_GVSFrom := INT_TO_REAL(AI_P_GVSFrom) / 10.0;
FAI_P_Set := INT_TO_REAL(AI_P_Set) / 10.0;
FAI_P_GAZ := INT_TO_REAL(AI_P_GAZ) / 10.0;

(* ОБРЫВ ДАТЧИКОВ ТЕМПЕРАТУРЫ. Модуль отдаёт ровно -1990 (-199.0 C) на
   разомкнутом Pt100, поэтому сравниваем с -1990 на равенство.
   Вход - сырые регистры АЦП R2370x, а не показания AI_T_*: в показаниях уже
   прибавлена поправка Cor_* с панели, и признак обрыва был бы искажён.
   Аварии 36/37/38 (котлы 1/2/3) идут в группы 1/2/3 - такой котёл
   выводится из каскада через arBurners[i].Error, как перегрев.
   Авария 39 (коллектор) и 43 (обратка ТО ГВС) дополнительно снимают
   ПИД каскада и ПИД 3-ходового клапана - см. PRG_MAIN.
   Аварии 40/41/42/44/45 - только сигнализация, в логике не участвуют. *)
fbAmSet(iNum := 36, xState := R23700 = -1990);   (* T котла 1 *)
fbAmSet(iNum := 37, xState := R23701 = -1990);   (* T котла 2 *)
fbAmSet(iNum := 38, xState := R23702 = -1990);   (* T котла 3 *)
fbAmSet(iNum := 39, xState := R23704 = -1990);   (* T коллектора *)
fbAmSet(iNum := 40, xState := R23703 = -1990);   (* T обратки отопления *)
fbAmSet(iNum := 41, xState := R23705 = -1990);   (* T подачи отопления *)
fbAmSet(iNum := 42, xState := R23706 = -1990);   (* T подачи ГВС *)
fbAmSet(iNum := 43, xState := R23707 = -1990);   (* T обратки ГВС *)
fbAmSet(iNum := 44, xState := R23709 = -1990);   (* T газа *)
fbAmSet(iNum := 45, xState := R23708 = -1990);   (* T улицы *)
(* НУЛЕВОЕ ДАВЛЕНИЕ (обрыв линии 4..20 мА или отказ датчика).
   На разомкнутой линии 4..20 мА модуль отдаёт ровно 0 (после F_SCALE это
   0.0 бара), поэтому сравниваем с 0 на равенство. Вход - сырые регистры
   R2371x, газ - встроенный вход D8032. Показание 2 отсчёта и выше означает
   живой датчик и тревоги не даёт: 2 отсчёта - это уже сигнал с датчика.
   Давление котла (46/47/48) идёт в группы 1/2/3 - котёл выходит из
   каскада, как при перегреве.
   Давление в системе (49), газа (50) и давлений отопления/ГВС (51..54) -
   группа 10, насосы они НЕ запрещают. По аварии 49 закрывается подпитка. *)
fbAmSet(iNum := 46, xState := R23712 = 0);   (* давление котла 1 *)
fbAmSet(iNum := 47, xState := R23713 = 0);   (* давление котла 2 *)
fbAmSet(iNum := 48, xState := R23714 = 0);   (* давление котла 3 *)
fbAmSet(iNum := 49, xState := R23719 = 0);   (* давление в системе *)
fbAmSet(iNum := 50, xState := D8032 = 0);    (* давление газа *)
fbAmSet(iNum := 51, xState := R23715 = 0);   (* давление подачи отопления *)
fbAmSet(iNum := 52, xState := R23716 = 0);   (* давление обратки отопления *)
fbAmSet(iNum := 53, xState := R23717 = 0);   (* давление подачи ГВС *)
fbAmSet(iNum := 54, xState := R23718 = 0);   (* давление обратки ГВС *)


T1_State := HEATER_STATE(arBurners[0]);
T2_State := HEATER_STATE(arBurners[1]);
T3_State := HEATER_STATE(arBurners[2]);

(* Состояние насоса для панели: 0 - выкл, 1 - работает, 2 - авария,
   4 - запрещён. Второй параметр - признак аварии насоса из менеджера тревог *)
Pump1_T1_State := PUMP_STATE(DO_Pump1_T1, AM_ALARMS[15].Alarm, gxPump1_T1_Enable);
Pump2_T1_State := PUMP_STATE(DO_Pump2_T1, AM_ALARMS[16].Alarm, gxPump2_T1_Enable);
Pump1_T1_2_State := PUMP_STATE(DO_Pump1_T1_2, AM_ALARMS[17].Alarm, gxPump1_T1_2_Enable);
Pump2_T1_2_State := PUMP_STATE(DO_Pump2_T1_2, AM_ALARMS[18].Alarm, gxPump2_T1_2_Enable);
Pump1_T3_State := PUMP_STATE(DO_Pump1_T3, AM_ALARMS[19].Alarm, gxPump1_T3_Enable);
Pump2_T3_State := PUMP_STATE(DO_Pump2_T3, AM_ALARMS[20].Alarm, gxPump2_T3_Enable);
Pump1_State := PUMP_STATE(DO_Pump1, AM_ALARMS[21].Alarm, gxEnablePump1);
Pump2_State := PUMP_STATE(DO_Pump2, AM_ALARMS[22].Alarm, gxEnablePump2);
Pump3_State := PUMP_STATE(DO_Pump3, AM_ALARMS[23].Alarm, gxEnablePump3);

IF AI_T_Weather <= SV_TWeather1 THEN
	giTSV := SV_TWater1;
ELSIF AI_T_Weather <= SV_TWeather2 THEN
	giTSV := F_SCALE(AI_T_Weather, SV_TWeather1, SV_TWeather2, SV_TWater1, SV_TWater2, FALSE);
ELSIF AI_T_Weather <= SV_TWeather3 THEN
	giTSV := F_SCALE(AI_T_Weather, SV_TWeather2, SV_TWeather3, SV_TWater2, SV_TWater3, FALSE);
ELSIF AI_T_Weather <= SV_TWeather4 THEN
	giTSV := F_SCALE(AI_T_Weather, SV_TWeather3, SV_TWeather4, SV_TWater3, SV_TWater4, FALSE);
ELSE
	giTSV := SV_TWater4;
END_IF;

fbAmSet(iNum := 0, xState := AI_T_Heater1 > SV_MaxTemperatureHeater);
fbAmSet(iNum := 1, xState := AI_P1 > SV_MaxPressure);
fbAmSet(iNum := 2, xState := AI_P1 < SV_MinPressure AND R23712 <> 0);
fbAmSet(iNum := 3, xState := DI_BurnAlarm1);
fbAmHasAlarm(iSeverity := c_AM_ERROR, iProcessNum := 1);
arBurners[0].Error := fbAmHasAlarm.Q;
arBurners[0].Manual := arBurners[0].Manual OR arBurners[0].ManualSecond;
arBurners[0].Work := DI_BurnWork1;
arBurners[0].Temperature := AI_T_Heater1;
arBurners[0].Pressure := AI_P1;
DO_Burn1Power := arBurners[0].Power;
DO_Burn1Stage1 := arBurners[0].Stage1;
DO_Burn1Stage2 := arBurners[0].Stage2;

fbAmSet(iNum := 5, xState := AI_T_Heater2 > SV_MaxTemperatureHeater);
fbAmSet(iNum := 6, xState := AI_P2 > SV_MaxPressure);
fbAmSet(iNum := 7, xState := AI_P2 < SV_MinPressure AND R23713 <> 0);
fbAmSet(iNum := 8, xState := DI_BurnAlarm2);
fbAmHasAlarm(iSeverity := c_AM_ERROR, iProcessNum := 2);
arBurners[1].Error := fbAmHasAlarm.Q;
arBurners[1].Manual := arBurners[1].Manual OR arBurners[1].ManualSecond;
arBurners[1].Work := DI_BurnWork2;
arBurners[1].Temperature := AI_T_Heater2;
arBurners[1].Pressure := AI_P2;
DO_Burn2Power := arBurners[1].Power;
DO_Burn2Stage1 := arBurners[1].Stage1;
DO_Burn2Stage2 := arBurners[1].Stage2;

fbAmSet(iNum := 10, xState := AI_T_Heater3 > SV_MaxTemperatureHeater);
fbAmSet(iNum := 11, xState := AI_P3 > SV_MaxPressure);
fbAmSet(iNum := 12, xState := AI_P3 < SV_MinPressure AND R23714 <> 0);
fbAmSet(iNum := 13, xState := DI_BurnAlarm3);
fbAmHasAlarm(iSeverity := c_AM_ERROR, iProcessNum := 3);
arBurners[2].Error := fbAmHasAlarm.Q;
arBurners[2].Manual := arBurners[2].Manual OR arBurners[2].ManualSecond;
arBurners[2].Work := DI_BurnWork3;
arBurners[2].Temperature := AI_T_Heater3;
arBurners[2].Pressure := AI_P3;
DO_Burn3Power := arBurners[2].Power;
DO_Burn3Stage1 := arBurners[2].Stage1;
DO_Burn3Stage2 := arBurners[2].Stage2;

(* DO_Pump1_T1 *)
fbAmSet(iNum := 15, xState := DO_Pump1_T1 AND NOT DI_Pump1_T1);
(* DO_Pump2_T1 *)
fbAmSet(iNum := 16, xState := DO_Pump2_T1 AND NOT DI_Pump2_T1);
(* DO_Pump1_T1_2 *)
fbAmSet(iNum := 17, xState := DO_Pump1_T1_2 AND NOT DI_Pump1_T1_2);
(* DO_Pump2_T1_2 *)
fbAmSet(iNum := 18, xState := DO_Pump2_T1_2 AND NOT DI_Pump2_T1_2);
(* DO_Pump1_T3 *)
fbAmSet(iNum := 19, xState := DO_Pump1_T3 AND NOT DI_Pump1_T3);
(* DO_Pump2_T3 *)
fbAmSet(iNum := 20, xState := DO_Pump2_T3 AND NOT DI_Pump2_T3);
(* DO_Pump1 *)
fbAmSet(iNum := 21, xState := DO_Pump1 AND NOT DI_Pump1);
(* DO_Pump2 *)
fbAmSet(iNum := 22, xState := DO_Pump2 AND NOT DI_Pump2);
(* DO_Pump3 *)
fbAmSet(iNum := 23, xState := DO_Pump3 AND NOT DI_Pump3);

iAvailable := 0;
FOR iCount := 0 TO c_HEATERS_IDX DO
    INC(
    	(arBurners[iCount].Auto OR arBurners[iCount].Manual)
    	AND NOT arBurners[iCount].Error
    	AND arBurners[iCount].Enable,
    	iAvailable
    );
END_FOR;

fbAmSet(iNum := 24, xState := AI_P_GAZ < SV_GasMinPressure);
(* 25 - давление в системе ниже минимального: запрет насосов.
   На 0.0 бара эта авария не срабатывает (там авария 49): обрыв датчика
   не должен останавливать насосы навсегда - иначе котельная не пустится. *)
fbAmSet(iNum := 25, xState := AI_P_Set < SV_SetMinPressure AND R23719 <> 0);
fbAmSet(iNum := 26, xState := NOT DI_EKM);
fbAmSet(iNum := 27, xState := NOT DI_ES);
fbAmSet(iNum := 28, xState := NOT DI_RKF);
fbAmSet(iNum := 29, xState := gxStart AND iAvailable = 0);
fbAmSet(iNum := 30, xState := gxNoSettings);

(* 31 - пуск котлов запрещён, пока не запущен хотя бы один насос.
   Проверяем ДО пуска (по gxStart), иначе первый цикл котлы включаются
   раньше насосов. Авария без защёлки и блокирующая (xLock = 1). *)
fbAmSet(iNum := 31, xState := gxStart AND NOT (DO_Pump1 OR DO_Pump2 OR DO_Pump3));

fbAmSet(iNum := 32, xState := AI_T_Colector > SV_MaxTemperatureColector);

fbAmSet(iNum := 33, xState := AI_P_Set > SV_MaxPressure);

OUT_T(DO_ValveFill, TC12, SV_MaxFillTime * 10);
fbAmSet(iNum := 34, xState := TS12);

fbAmSet(iNum := 35, xState := AI_T_GVSFrom > SV_3WayMaxTemperature);

(* 4, 9, 14 - термозащита котлов: авария, если пропал контакт (X035..X037).
   Номера взяты из резервных слотов групп котлов, поэтому тревога
   выводит из каскада только свой котёл, а упаковка для панели
   для панели остаётся сплошной: авария n уходит в бит M(530 + n), т.е. 534 / 539 / 544 *)
fbAmSet(iNum := 4, xState := NOT DI_BurnTherm1);
fbAmSet(iNum := 9, xState := NOT DI_BurnTherm2);
fbAmSet(iNum := 14, xState := NOT DI_BurnTherm3);

fbAMPack(DNUM := 530, PD := c_AM_PACK_M);

(* Наличие любой аварии берём у менеджера тревог, а не суммой упакованных битов:
   сумма 16-битная и могла переполниться в 0 *)
fbAmHasAny(iProcessNum := 0, iSeverity := 0);
gxHasalarm := fbAmHasAny.Q;
DO_AlarmLight := gxHasalarm;

(* Настройки считаются введёнными, если заполнены уставки и коэффициенты ПИД.
   R503 входит в блок параметров ПИД (R500..R528) и задаётся с панели:
   если он 0, значит коэффициенты регулятора не введены.
   Расчёт идёт ниже вызова fbAmSet(30) намеренно: авария реагирует
   с задержкой в один цикл, это допустимо. *)
gxNoSettings := (R503 = 0)
	OR (SV_TLimit = 0)
	OR (SV_MaxPressure = 0)
	OR (SV_MinPressure = 0)
	OR (SV_MaxTemperatureHeater = 0)
	OR (SV_TWeather1 = 0)
	OR (SV_TWeather2 = 0)
	OR (SV_TWeather3 = 0)
	OR (SV_TWeather4 = 0)
	OR (SV_TWater1 = 0)
	OR (SV_TWater2 = 0)
	OR (SV_TWater3 = 0)
	OR (SV_TWater4 = 0)
	OR (SV_GasMinPressure = 0)
	OR (SV_SetMinPressure = 0)
   OR (SV_3WayTempGVS = 0)
   OR (SV_HowOftenToCheck = 0)
   OR (SV_PresFilStart = 0)
   OR (SV_PresFilStop = 0)
   OR (SV_MaxFillTime = 0)
   OR (SV_3WayDelta = 0)
   OR (SV_3WayTotalTime = 0)
   OR (SV_3WayLuftTime = 0)
   OR (SV_3WayTempGVSDelta = 0)
   OR (SV_3WayManualTask = 0)
   OR (Max_P1 = 0)
	OR (Max_P2 = 0)
	OR (Max_P3 = 0)
	OR (Max_P_SOTo = 0)
	OR (Max_P_SOFrom = 0)
	OR (Max_P_GVSTo = 0)
	OR (Max_P_GVSFrom = 0)
	OR (Max_P_Set = 0)
	OR (Max_P_GAZ = 0)
   OR (SV_3WayMaxTemperature = 0)
   OR (SV_MaxTemperatureColector = 0)
    ;
(* Сброс аварий. IN - IN_OUT: блок держит импульс сброса 500 мс и сам гасит
   сигнал, поэтому отдельный RST не нужен. AutoReset не задаём: автосброс
   защёлкнутых аварий нужен только в особых случаях (например, однократный
   сбой связи, который слишком короткий, чтобы его заметила панель) *)
fbAmReset(IN := gxErrorReset);

(* Сирена. Блок сам защёлкивает Q, когда звуковых аварий стало больше,
   и снимает его по входу Reset, поэтому SET/RST не нужны.
   Reset - IN_OUT, в него можно передать только метку, поэтому кнопки сброса
   сводим в одну переменную *)
xBuzzerReset := gxResetAlarm OR gxErrorReset OR DI_AlarmReset;
fbAMBuzzer(Reset := xBuzzerReset, Q := DO_AlarmBuzzer);

(* Моточасы. У каждого счётчика свой флаг переполнения *)
HOUR(DO_Burn1Stage1, K32000, giHeater1Hours, gxWHOvfHeater1);
IF gxResetWHT1 THEN giHeater1Hours[0] := 0; giHeater1Hours[1] := 0; END_IF;
HOUR(DO_Burn2Stage1, K32000, giHeater2Hours, gxWHOvfHeater2);
IF gxResetWHT2 THEN giHeater2Hours[0] := 0; giHeater2Hours[1] := 0; END_IF;
HOUR(DO_Burn3Stage1, K32000, giHeater3Hours, gxWHOvfHeater3);
IF gxResetWHT3 THEN giHeater3Hours[0] := 0; giHeater3Hours[1] := 0; END_IF;
HOUR(DO_Pump1_T1, K32000, Pump1_T1_WH, gxWHOvfPump1_T1);
IF gxPump1_T1_WHReset THEN Pump1_T1_WH[0] := 0; Pump1_T1_WH[1] := 0; END_IF;
HOUR(DO_Pump2_T1, K32000, Pump2_T1_WH, gxWHOvfPump2_T1);
IF gxPump2_T1_WHReset THEN Pump2_T1_WH[0] := 0; Pump2_T1_WH[1] := 0; END_IF;
HOUR(DO_Pump1_T1_2, K32000, Pump1_T1_2_WH, gxWHOvfPump1_T1_2);
IF gxPump1_T1_2_WHReset THEN Pump1_T1_2_WH[0] := 0; Pump1_T1_2_WH[1] := 0; END_IF;
HOUR(DO_Pump2_T1_2, K32000, Pump2_T1_2_WH, gxWHOvfPump2_T1_2);
IF gxPump2_T1_2_WHReset THEN Pump2_T1_2_WH[0] := 0; Pump2_T1_2_WH[1] := 0; END_IF;
HOUR(DO_Pump1_T3, K32000, Pump1_T3_WH, gxWHOvfPump1_T3);
IF gxPump1_T3_WHReset THEN Pump1_T3_WH[0] := 0; Pump1_T3_WH[1] := 0; END_IF;
HOUR(DO_Pump2_T3, K32000, Pump2_T3_WH, gxWHOvfPump2_T3);
IF gxPump2_T3_WHReset THEN Pump2_T3_WH[0] := 0; Pump2_T3_WH[1] := 0; END_IF;
HOUR(DO_Pump1, K32000, Pump1_WH, gxWHOvfPump1);
IF gxPump1_WHReset THEN Pump1_WH[0] := 0; Pump1_WH[1] := 0; END_IF;
HOUR(DO_Pump2, K32000, Pump2_WH, gxWHOvfPump2);
IF gxPump2_WHReset THEN Pump2_WH[0] := 0; Pump2_WH[1] := 0; END_IF;
HOUR(DO_Pump3, K32000, Pump3_WH, gxWHOvfPump3);
IF gxPump3_WHReset THEN Pump3_WH[0] := 0; Pump3_WH[1] := 0; END_IF;